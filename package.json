{
  "name": "aba-workbench",
  "productName": "ABA Workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Drafts ABA initial assessments section by section. Desktop app for macOS and Windows.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "phase0": "node --env-file-if-exists=.env.phase0 scripts/phase0.mts",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "openai": "^7.62.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  }
}
