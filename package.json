{
  "name": "aba-workbench",
  "productName": "ABA Workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Drafts ABA initial assessments section by section. Desktop app for macOS and Windows.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "install-electron && electron-vite dev",
    "build": "electron-vite build",
    "preview": "install-electron && electron-vite preview",
    "package": "electron-vite build && electron-builder --dir",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.node.json && tsc --noEmit --composite false -p tsconfig.web.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "install-electron && electron-vite build && playwright test --project=built",
    "test:e2e:packaged": "playwright test --project=packaged",
    "phase0": "node --env-file-if-exists=.env.phase0 scripts/phase0.mts",
    "check:pdf-reader": "install-electron && electron-vite build && vite build --config scripts/check-pdf-reader.vite.config.ts --logLevel warn && electron tmp/check-pdf-reader/bundle/check.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@base-ui/react": "1.9.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "i18next": "27.2.2",
    "jose": "^6.2.18",
    "openai": "^7.62.0",
    "pdfjs-dist": "6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "18.0.3",
    "react-router": "8.5.2",
    "tailwindcss": "4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  }
}
